{
  "name": "florascan-backend",
  "version": "1.0.0",
  "description": "Production-grade Agri-Tech Backend API for FloraScan.ai Disease Detector and Care Hub",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate --schema=src/models/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/models/prisma/schema.prisma",
    "seed": "node scripts/seedData.js"
  },
  "keywords": [
    "agritech",
    "plant-disease",
    "geospatial-radar",
    "postgis",
    "tflite",
    "voice-ai"
  ],
  "author": "FloraScan.ai Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
